{
  "name": "telaah",
  "private": true,
  "version": "0.0.0",
  "description": "Review game catur pribadi dari arsip publik, berjalan di browser.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "salin:engine": "node skrip/salinEngine.mjs",
    "predev": "npm run salin:engine",
    "dev": "vite",
    "prebuild": "npm run salin:engine",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:engine",
    "test:unit": "vitest run --exclude \"**/*.integrasi.test.*\"",
    "test:engine": "vitest run .integrasi.test --no-file-parallelism",
    "lint": "eslint .",
    "tipe": "tsc -b",
    "format": "prettier --write .",
    "kontras": "vitest run src/gaya/kontras.test.ts --silent=false",
    "periksa": "npm run tipe && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "chess.js": "1.4.0",
    "dexie": "4.4.6",
    "react": "19.3.0",
    "react-chessboard": "5.12.1",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "3.10.1",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
